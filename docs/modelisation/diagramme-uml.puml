@startuml
' Diagramme UML de Classes - Modele Conceptuel et Logique de Donnees
' Projet: Plateforme d'Aide a la Decision Feux de Foret - Seine-et-Marne (SDIS 77)
' Compatible StarUML / PlantUML

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 5
skinparam shadowing false

package "Referentiel Spatial & Administratif" {
    class Commune {
        + code_insee: String [PK]
        + nom_commune: String
        + code_postal: String
        + superficie_totale_ha: Float
        + surface_boisee_ha: Float
        + taux_boisement: Float
        + zone_interface_wui_ha: Float
        + population_insee: Integer
        + geom: Polygon
    }

    class MassifForestier {
        + id_massif: String [PK]
        + nom_massif: String
        + surface_totale_ha: Float
        + type_peuplement_dominant: String
        + vulnerabilite_sol: String
        + statut_protection: String
    }

    class CentreIncendieSecours {
        + code_cis: String [PK]
        + nom_cis: String
        + groupement_territorial: String
        + effectif_garde_spp: Integer
        + effectif_garde_spv: Integer
        + dotation_ccf: Integer
        + coord_x: Float
        + coord_y: Float
    }
}

package "Evenements & Sinistres" {
    class Incendie {
        + id_incendie: String [PK]
        + code_insee: String [FK]
        + date_premiere_alerte: Date
        + heure_premiere_alerte: Time
        + date_extinction: Date
        + surface_parcourue_totale_ha: Float
        + surface_foret_ha: Float
        + surface_agricole_chaume_ha: Float
        + type_vegetation: String
        + nature_cause: String
        + coord_lat: Float
        + coord_lon: Float
        + source_signalement: String
    }
}

package "Conditions Meteorologiques & Risque" {
    class MeteoDepartementaleJour {
        + date_observation: Date [PK]
        + code_departement: String [PK]
        + niveau_meteo_forets: String
        + temperature_max_c: Float
        + humidite_min_pourcent: Float
        + vitesse_vent_rafale_kmh: Float
        + direction_vent_dominante: String
        + cumul_precipitations_mm: Float
        + indice_fwi_moyen: Float
    }
}

package "Dispositif Operationnel & Mobilisation" {
    class DispositifOperationnel {
        + id_dispositif: String [PK]
        + date_dispositif: Date [FK]
        + code_cis: String [FK]
        + regle_declenchement: String
        + niveau_alerte_active: String
        + nb_patrouilles_giff_postees: Integer
        + nb_engins_ccf_mobilises: Integer
        + guet_arme_active: Boolean
        + feu_survenu_sur_secteur: Boolean
        + cout_mobilisation_eur: Float
    }
}

package "Couche Gold - Perspectives Utilisateur SDIS 77" {
    class KpiConsolideAnnuel {
        + id_kpi: String [PK]
        + annee: Integer
        + maille_analyse: String
        + identifiant_entite: String
        + nb_feux_total: Integer
        + surface_brulee_totale_ha: Float
        + surface_brulee_p1000ha_boises: Float
        + taux_couverture_seuil_jaune: Float
        + taux_couverture_seuil_orange: Float
        + part_feux_inf_1ha: Float
        + nb_journees_mobilisees_a_vide: Integer
    }
}

' Relations et cardinalites
Commune "1..*" -- "1" MassifForestier : est rattachee a >
Commune "1" -- "0..*" Incendie : localise sur >
CentreIncendieSecours "1" -- "1..*" Commune : couvre le premier appel de >

MeteoDepartementaleJour "1" -- "0..*" DispositifOperationnel : declenche >
DispositifOperationnel "0..*" -- "1" CentreIncendieSecours : arme par >

Incendie "0..*" -- "0..1" DispositifOperationnel : couvert par >

Commune "1" -- "0..*" KpiConsolideAnnuel : consolidee dans >
MassifForestier "1" -- "0..*" KpiConsolideAnnuel : agrege dans >

@enduml
